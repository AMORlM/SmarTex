{
  "compiler": {
    "type": "dropdown",
    "label": "Compiler",
    "values": ["pdftex", "pdflatex", "luatex","lualatex", "xetex", "xelatex","latex"],
    "default": "latex"
  },
  "mainFile": {
    "type": "fileSelector",
    "label": "Main File",
    "source": "projectFiles",
    "extensions": [".tex"],
    "default": null,
    "requiredStrategy": "first"
  },
  "outputFile": {
    "type": "string",
    "label": "Output PDF",
    "default": "main.pdf"
  },
  "executionOrder": {
    "type": "listBuilder",
    "label": "Execution Order",
    "allowedValues": ["compile", "index", "bib"],
    "default": ["compile"]
  }
}
