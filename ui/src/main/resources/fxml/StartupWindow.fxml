<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.smartex.ui.components.recentproject.RecentProjectsListView?>

<BorderPane prefHeight="450.0" prefWidth="700.0"
            stylesheets="@../styles/dracula.css"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartex.ui.startup.StartupWindowController">

    <!-- Top action buttons -->
    <top>
        <HBox alignment="TOP_RIGHT" spacing="10">
            <padding>
                <Insets bottom="20"/>
            </padding>
            <Button onAction="#onNewProject" text="New Project" />
            <Button onAction="#onOpenProject" text="Open Project" />
        </HBox>
    </top>

    <!-- Center recent projects list -->
    <center>
        <RecentProjectsListView fx:id="recentListView"/>
    </center>

    <!-- Root padding -->
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
</BorderPane>
