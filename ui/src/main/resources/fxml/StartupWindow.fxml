<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="700.0" stylesheets="@../styles/dracula.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartex.ui.startup.StartupWindowController">

    <!-- Top action buttons -->
    <top>
        <HBox alignment="TOP_RIGHT" spacing="10">
            <padding>
                <Insets bottom="20" />
            </padding>
            <Button onMouseClicked="#setNewProject" text="New Project" />
            <Button onMouseClicked="#setOpenProject" text="Open Project" />
        </HBox>
    </top>



    <!-- Root padding -->
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
</BorderPane>
