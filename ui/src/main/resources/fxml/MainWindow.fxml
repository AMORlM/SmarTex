<?xml version="1.0" encoding="UTF-8"?>

<?import com.smartex.ui.components.CompilationPane?>
<?import com.smartex.ui.components.FileTabPane?>
<?import com.smartex.ui.components.ProjectTree?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../styles/dracula.css"
            fx:controller="com.smartex.ui.main.MainWindowController">

    <top>
        <ToolBar>
            <Button onAction="#onNewProject" text="New Project"/>
            <Button onAction="#onOpenProject" text="Open Project"/>
            <Button onAction="#onSave" text="Save File"/>
            <Button onAction="#onSettings" text="Settings"/>
        </ToolBar>
    </top>

    <center>
        <SplitPane dividerPositions="0.15,0.65">
            <ProjectTree fx:id="projectTree"/>
            <FileTabPane fx:id="fileTabPane"/>
            <CompilationPane fx:id="compilationPane"/>
        </SplitPane>
    </center>
</BorderPane>
